@import url("unity-theme://default");

.cartowords .unity-text-element { color: rgb(229, 233, 242); }
.cartowords .muted { color: rgb(155, 165, 185); }
.cartowords .brand { color: rgb(76, 190, 208); -unity-font-style: bold; font-size: 19px; }
.cartowords .save-status {
    color: rgb(255, 174, 135);
    background-color: rgb(63, 40, 38);
    border-radius: 6px;
    padding: 5px 10px;
    font-size: 12px;
}
.cartowords .editor-card {
    background-color: rgb(23, 27, 39);
    border-width: 1px;
    border-color: rgb(55, 63, 83);
    border-radius: 12px;
}
.cartowords .section-label {
    color: rgb(155, 165, 185);
    font-size: 12px;
    margin-top: 18px;
    margin-bottom: 10px;
}
.cartowords .unity-button {
    background-color: rgb(47, 55, 73);
    border-color: rgb(66, 77, 98);
    border-width: 1px;
    border-radius: 6px;
    margin-right: 6px;
    padding: 7px 12px;
    flex-shrink: 0;
    font-size: 13px;
}
.cartowords .unity-button:hover {
    background-color: rgb(62, 76, 98);
    border-color: rgb(90, 126, 151);
}
.cartowords .unity-button:active { background-color: rgb(29, 91, 111); }
.cartowords .unity-button:disabled { opacity: 0.38; }
.cartowords .primary-action {
    background-color: rgb(29, 108, 132);
    border-color: rgb(52, 151, 175);
    margin-bottom: 18px;
}
.cartowords .primary-action:hover { background-color: rgb(35, 130, 151); }
.cartowords .town-folder > .unity-foldout__toggle {
    margin-top: 8px;
    margin-bottom: 4px;
    padding-top: 4px;
    padding-bottom: 4px;
}
.cartowords .note-row {
    background-color: rgb(26, 31, 45);
    border-color: rgb(45, 53, 72);
    margin-top: 3px;
    margin-bottom: 3px;
    padding: 8px 10px;
}
.cartowords .note-row--selected {
    background-color: rgb(28, 92, 119);
    border-color: rgb(48, 146, 168);
    border-left-width: 3px;
}
.cartowords .note-row--selected:hover { background-color: rgb(32, 110, 136); }
.cartowords .unity-text-field__input {
    background-color: rgb(37, 43, 59);
    border-color: rgb(65, 74, 95);
    border-width: 1px;
    border-radius: 7px;
    padding: 12px 14px;
    color: rgb(235, 239, 246);
    --unity-cursor-color: rgb(88, 208, 217);
    --unity-selection-color: rgba(43, 141, 167, 0.5);
}
.cartowords .unity-text-field__input:focus { border-color: rgb(64, 158, 180); }
.cartowords .note-title .unity-text-field__input {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 4px 0;
    -unity-font-style: bold;
}
.cartowords .note-title .unity-text-field__input:focus { background-color: rgb(32, 39, 54); }
.cartowords .note-body .unity-text-field__input { padding: 16px; }
.cartowords .unity-scroller { background-color: rgb(26, 31, 45); }
.cartowords .unity-scroller .unity-slider__tracker { background-color: rgb(35, 42, 58); }
.cartowords .unity-scroller .unity-slider__dragger {
    background-color: rgb(76, 91, 115);
    border-radius: 5px;
}

/* Map + workbench: reference layout, without changing editor input behavior. */
.cartowords .map-panel {
    position: relative;
    min-width: 240px;
    background-color: rgb(11, 22, 36);
    border-right-width: 1px;
    border-right-color: rgb(47, 61, 79);
}
.cartowords .map-tools { position: absolute; top: 44px; right: 12px; width: 52px; }
.cartowords .map-tools .unity-button { margin-right: 0; font-size: 12px; padding: 6px; }
.cartowords .map-caption {
    position: absolute; top: 12px; left: 12px; right: 76px;
    font-size: 11px; white-space: normal;
    color: rgb(194, 217, 227); background-color: rgba(16, 28, 44, 0.9);
    border-radius: 5px; padding: 6px 8px;
}
.cartowords .map-info {
    position: absolute; bottom: 12px; left: 12px; right: 12px;
    font-size: 11px; white-space: normal;
    color: rgb(210, 222, 232); background-color: rgba(10, 20, 33, 0.93);
    border-radius: 6px; padding: 8px 10px;
}
.cartowords .map-preview-button { position: absolute; bottom: 65px; right: 12px; font-size: 11px; }
.cartowords .right-workspace { padding: 10px; background-color: rgb(29, 34, 48); }
.cartowords .note-header { padding: 4px 12px; flex-shrink: 0; }
.cartowords .workbench {
    background-color: rgb(23, 28, 40);
    border-width: 1px; border-color: rgb(50, 59, 78); border-radius: 9px;
    overflow: hidden;
}
.cartowords .sidebar {
    padding-top: 14px;
    border-right-width: 1px; border-right-color: rgb(47, 57, 76);
}
.cartowords .sidebar .unity-label { font-size: 12px; }
.cartowords .sidebar .section-label { margin-top: 8px; }
.cartowords .sidebar .unity-button { font-size: 12px; padding: 7px 8px; margin-right: 0; }
.cartowords .editor-sheet { background-color: rgba(0, 0, 0, 0); }
.cartowords .format-toolbar .unity-button { padding: 4px 7px; font-size: 11px; min-height: 26px; }
.cartowords .map-palette {
    position: absolute; top: 230px; right: 12px; width: 210px;
    padding: 12px; border-width: 1px; border-color: rgb(63, 84, 103);
    border-radius: 8px; background-color: rgb(25, 37, 54);
}
.cartowords .map-palette .unity-base-field__label { min-width: 25px; width: 25px; }

/* Compact controls keep the map wide and reserve height for writing. */
.cartowords .brand { font-size: 15px; }
.cartowords .save-status { font-size: 10px; padding: 2px 6px; }
.cartowords .project-bar { height: 29px; align-items: center; margin-bottom: 3px; }
.cartowords .project-bar .unity-button { font-size: 11px; padding: 2px 8px; height: 24px; margin-top: 0; margin-bottom: 0; }
.cartowords .project-bar .unity-text-field__input { padding: 2px 6px; font-size: 11px; }
.cartowords .project-bar .unity-base-field__label { min-width: 75px; font-size: 11px; }
.cartowords .right-workspace { padding: 4px; }
.cartowords .note-header { padding: 2px 8px; }
.cartowords .format-toolbar .unity-button { padding: 2px 5px; font-size: 10px; min-height: 21px; margin-right: 3px; margin-top: 1px; margin-bottom: 3px; }
.cartowords .sidebar { padding-top: 6px; }
.cartowords .sidebar .unity-button { font-size: 11px; padding: 4px 5px; }
.cartowords .sidebar .primary-action { margin-bottom: 6px; }
.cartowords .sidebar .section-label { margin-top: 4px; margin-bottom: 4px; }
.cartowords .note-mini-menu { background-color: rgb(34, 43, 58); border-width: 1px; border-color: rgb(76, 100, 119); border-radius: 5px; padding: 4px; margin-bottom: 5px; }
.cartowords .note-mini-menu .unity-button { -unity-text-align: middle-left; }
.cartowords .related-notes { align-items: center; flex-shrink: 0; margin-bottom: 5px; }
.cartowords .related-notes .unity-label { font-size: 11px; margin-right: 5px; }
.cartowords .related-notes .unity-base-popup-field__input { padding: 3px 6px; font-size: 11px; }
.cartowords .related-notes .unity-button { font-size: 11px; padding: 3px 7px; }
